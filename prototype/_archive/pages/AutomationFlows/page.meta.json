    { "name": "mockFlowRunsData", "shape": "array", "endpoint": { "method": "GET", "path": "/api/v1/automation-runs" }, "queryParams": ["flowId", "status"] },
    { "name": "mockFlowTemplatesData", "shape": "array", "endpoint": { "method": "GET", "path": "/api/v1/automation-flows/templates" } }
  ],
  "actions": [
