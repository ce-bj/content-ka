    { "handler": "handleToggleAutomationFlow", "endpoint": { "method": "PATCH", "path": "/api/v1/automation-flows/{id}" }, "requestFrom": "body", "responseShape": "object" },
    { "handler": "handleRunAutomationFlow", "endpoint": { "method": "POST", "path": "/api/v1/automation-flows/{id}/runs" }, "requestFrom": "param", "responseShape": "object" },
    { "handler": "handleFetchFlowRuns", "endpoint": { "method": "GET", "path": "/api/v1/automation-runs" }, "requestFrom": "param", "responseShape": "array" },
